def load_api_key():
    """Load DEEPGRAM_API_KEY from env or a local dotenv-style file."""
    key = os.environ.get("DEEPGRAM_API_KEY")
    if key:
        return key
    for path in (ENV_FILE, OPERATOR_ENV_FILE):
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("DEEPGRAM_API_KEY="):
                        return line.split("=", 1)[1].strip().strip("'\"")
        except (FileNotFoundError, PermissionError):
            pass
    return None


def get_icy_metadata(url, timeout=5):
    """Fetch StreamTitle from ICY metadata embedded in an audio stream."""
    try:
        req = urllib.request.Request(url, headers={
            "Icy-MetaData": "1",
            "User-Agent": "Mozilla/5.0",
        })
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            metaint = int(resp.headers.get("icy-metaint", 0))
            if not metaint:
                return None
            resp.read(metaint)
            meta_len = struct.unpack("B", resp.read(1))[0] * 16
            if not meta_len:
                return None
            meta = resp.read(meta_len).decode("utf-8", errors="replace").rstrip("\x00")
            for part in meta.split(";"):
                part = part.strip()
                if part.startswith("StreamTitle="):
                    title = part.split("=", 1)[1].strip("'\"")
                    if title and title.strip() and title.lower() not in ("unknown", " "):
                        return title
    except Exception:
        pass
    return None


def get_kexp():
    try:
        url = "https://api.kexp.org/v2/plays/?limit=1&format=json"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
            if data.get("results"):
                p = data["results"][0]
                artist, song = p.get("artist", ""), p.get("song", "")
                if artist and song:
                    return f"{song} by {artist}"
                return artist or song or None
    except Exception:
        pass
    return None


def get_bff():
    try:
        url = "https://data.bff.fm/api/data/tracks/now.text"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            text = resp.read().decode("utf-8").strip()
            return text or None
    except Exception:
        pass
    return None



def get_ckdu():
    try:
        url = "https://api.ckdu.ca/api/graphql/v1"
        body = json.dumps({"query": '{ nowPlayingLogs(limit: 1) { song } }'}).encode()
        req = urllib.request.Request(url, data=body, headers={
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0",
        })
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
            logs = data.get("data", {}).get("nowPlayingLogs", [])
            if logs and logs[0].get("song"):
                return logs[0]["song"]
    except Exception:
        pass
    return None


def get_wnyc():
    try:
        url = "https://www.wnyc.org/api/v1/whats_on/"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
            show = data.get("wnyc-fm939", {}).get("current_show", {})
            return show.get("title") or None
    except Exception:
        pass
    return None


def get_mixfranco():
    """Fetch today's Mix Franco episode title from the podcast RSS feed."""
    import xml.etree.ElementTree as ET
    import json as _json
    try:
        req = urllib.request.Request(
            "https://itunes.apple.com/lookup?id=805602948&entity=podcast",
            headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = _json.load(resp)
        rss_url = data["results"][0]["feedUrl"]
    except Exception:
        rss_url = "http://podcast.cism893.ca/rss/mix-franco"
    try:
        req2 = urllib.request.Request(rss_url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req2, timeout=10) as resp2:
            root = ET.fromstring(resp2.read())
        item = root.find("channel/item")
        if item is not None:
            title_el = item.find("title")
            if title_el is not None and title_el.text:
                return title_el.text.strip()
    except Exception:
        pass
    return None


API_FETCHERS = {"kexp": get_kexp, "bff": get_bff, "wnyc": get_wnyc, "ckdu": get_ckdu, "mixfranco": get_mixfranco}


def format_track_info(info):
    """Format track info as 'Song, by Artist' when possible."""
    if not info:
        return None
    # ICY metadata is typically "Artist - Song"
    if " - " in info:
        parts = info.split(" - ", 1)
        if len(parts) == 2:
            artist, song = parts[0].strip(), parts[1].strip()
            if artist and song:
                return f"{song}, by {artist}"
    # Already formatted (from APIs) or no separator
    return info


def get_now_playing(station_id):
    station = STATIONS.get(station_id)
    if not station:
        return None
    # Try API first
    api = station.get("api")
    if api and api in API_FETCHERS:
        result = format_track_info(API_FETCHERS[api]())
        if result:
            return result
    # Fall back to ICY metadata
    stream = station.get("stream")
    if stream:
        raw = get_icy_metadata(stream)
        return format_track_info(raw)
    return None


def generate_tts_deepgram(text, output_path):
    """Generate 8kHz 16-bit mono wav using Deepgram Aura 2."""
    api_key = load_api_key()
    if not api_key:
        raise RuntimeError("No Deepgram API key")

    url = (
        f"https://api.deepgram.com/v1/speak"
        f"?model={DEEPGRAM_VOICE}&encoding=linear16&sample_rate=8000&container=none"
    )
    body = json.dumps({"text": text}).encode()
    req = urllib.request.Request(url, data=body, headers={
        "Authorization": f"Token {api_key}",
        "Content-Type": "application/json",
    })
    with urllib.request.urlopen(req, timeout=10) as resp:
        pcm_data = resp.read()

    with wave.open(output_path, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(8000)
        wav.writeframes(apply_pcm16_gain(pcm_data, TTS_GAIN))


def apply_pcm16_gain(pcm_data, gain):
    """Apply gain to little-endian signed 16-bit PCM with clipping."""
    if gain == 1:
        return pcm_data
    amplified = bytearray(len(pcm_data))
    for offset in range(0, len(pcm_data) - 1, 2):
        sample = int.from_bytes(pcm_data[offset:offset + 2], "little", signed=True)
        sample = max(-32768, min(32767, int(sample * gain)))
        amplified[offset:offset + 2] = sample.to_bytes(2, "little", signed=True)
    if len(pcm_data) % 2:
        amplified[-1] = pcm_data[-1]
    return bytes(amplified)


def generate_tts_espeak(text, output_path):
    """Fallback: generate 8kHz 16-bit mono wav using espeak-ng + ffmpeg."""
    if not shutil.which("espeak-ng"):
        raise RuntimeError("espeak-ng is not installed")
    if not shutil.which("ffmpeg"):
        raise RuntimeError("ffmpeg is not installed")
    espeak = subprocess.Popen(
        ["espeak-ng", "--stdout", "-v", "en-us", "-s", "150", text],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        [
            "ffmpeg", "-y", "-i", "pipe:0",
            "-filter:a", f"volume={TTS_GAIN}",
            "-ar", "8000", "-ac", "1", output_path,
        ],
        stdin=espeak.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        check=True,
    )


def generate_tts(text, output_path):
    """Generate TTS wav. Uses Deepgram, falls back to espeak-ng."""
    try:
        generate_tts_deepgram(text, output_path)
    except Exception as deepgram_error:
        try:
            generate_tts_espeak(text, output_path)
        except Exception as espeak_error:
            raise RuntimeError(
                f"TTS generation failed: Deepgram: {deepgram_error}; "
                f"espeak-ng: {espeak_error}"
            ) from espeak_error




def _get_ffplay_sink_inputs():
    """Find all ffplay PulseAudio sink input indices."""
    indices = []
    try:
        result = subprocess.run(
            ["sudo", "-u", AUDIO_USER, f"XDG_RUNTIME_DIR={AUDIO_RUNTIME_DIR}",
             "pactl", "list", "sink-inputs"],
            capture_output=True, text=True, timeout=5)
        current_index = None
        for line in result.stdout.splitlines():
            if line.startswith("Sink Input #"):
                current_index = line.split("#")[1].strip()
            elif "application.process.binary" in line and "ffplay" in line:
                if current_index:
                    indices.append(current_index)
    except Exception:
        pass
    return indices


def speaker_is_active():
    """Check if direct stream is playing on laptop speakers."""
    # Check if any ffplay process is running (launched by radio-speaker)
    try:
        result = subprocess.run(
            ["pgrep", "-x", "ffplay"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return result.returncode == 0
    except Exception:
        return False


def play_on_speaker(wav_path):
    """Play wav on laptop speakers, ducking the music stream."""
    # Lower ffplay's PulseAudio volume during announcement instead of
    # SIGSTOP (which causes stream servers to drop the connection).
    sink_indices = _get_ffplay_sink_inputs()
    for idx in sink_indices:
        subprocess.run(
            ["sudo", "-u", AUDIO_USER, f"XDG_RUNTIME_DIR={AUDIO_RUNTIME_DIR}",
             "pactl", "set-sink-input-volume", idx, "45%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(
        ["sudo", "-u", AUDIO_USER, f"XDG_RUNTIME_DIR={AUDIO_RUNTIME_DIR}",
         "paplay", wav_path],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    for idx in sink_indices:
        subprocess.run(
            ["sudo", "-u", AUDIO_USER, f"XDG_RUNTIME_DIR={AUDIO_RUNTIME_DIR}",
             "pactl", "set-sink-input-volume", idx, "100%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <bridge-name> [--tts output.wav]", file=sys.stderr)
        sys.exit(1)

    station_id = sys.argv[1]
    tts_output = None
    if len(sys.argv) >= 4 and sys.argv[2] == "--tts":
        tts_output = sys.argv[3]

    station = STATIONS.get(station_id)
    station_name = station["name"] if station else station_id
    station_ext = station.get("ext", "") if station else ""
    label = f"extension {station_ext}, {station_name}" if station_ext else station_name
    info = get_now_playing(station_id)
    text = f"{label}. {info}" if info else f"{label}. No track information available"
    print(text)

    if tts_output:
        generate_tts(text, tts_output)
        if speaker_is_active():
            play_on_speaker(tts_output)


if __name__ == "__main__":
    main()
